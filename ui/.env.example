# Firebase (Firestore) — Admin SDK, server-only. Path to the service-account
# JSON key. Reads (via /api routes) and writes (register-player, join-tournament)
# both go through the server; the browser never touches the database.
FIREBASE_SERVICE_ACCOUNT=./.secrets/firebase-admin.json

# Wallet HTTP service (wallet package). Proxied by POST /api/wallet/agents
WALLET_SERVICE_URL=https://production-us-west2.railway-registry.com

# Used for balance reads; the app targets Ethereum Sepolia (11155111) end-to-end.
NEXT_PUBLIC_SEPOLIA_RPC_URL=

# Dynamic — enable Sepolia under Chains & Networks in the dashboard
# https://app.dynamic.xyz/dashboard/developer/api
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=